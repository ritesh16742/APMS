# PostgreSQL connection string from your cloud provider (Neon, Supabase, Render, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Generate a long random value. Example: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional public app name shown in the UI
NEXT_PUBLIC_APP_NAME="APMS"
